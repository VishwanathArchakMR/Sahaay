{
  "manifest_version": 3,
  "name": "Sahaay Browser Bridge",
  "version": "0.1.0",
  "description": "Secure, authorized browser integration bridge for Sahaay Windows AI Agent",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "nativeMessaging",
    "sidePanel"
  ],
  "host_permissions": [],
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "background": {
    "service_worker": "dist/service-worker/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["dist/content/index.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Sahaay Browser Sidebar"
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": false
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
