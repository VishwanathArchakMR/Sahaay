# Sahaay Environment Configuration Template
# Copy to .env for local overrides. NEVER commit .env or secrets to version control.

# Server Configuration
SAHAAY_HOST=127.0.0.1
SAHAAY_PORT=8000
SAHAAY_ENVIRONMENT=development
SAHAAY_LOG_LEVEL=INFO

# Security & Authentication
# If left blank, a cryptographically secure token is generated on startup and output to stdout/log
SAHAAY_API_TOKEN=

# Storage & Database
SAHAAY_DATABASE_URL=sqlite:///./data/storage/sahaay.db
SAHAAY_TEMP_MEDIA_DIR=./data/temp_media

# Privacy Gateway Defaults
# When true, all external inference requests fail closed immediately
SAHAAY_PRIVACY_LOCAL_ONLY_MODE=true
SAHAAY_PRIVACY_STRICT_CONSENT=true
SAHAAY_PRIVACY_LOG_REDACTION=true

# Model Providers (Milestone 05 - Baseten & Meta Muse Image)
# 1. Baseten Provider for Muse Spark Open (Planner)
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MUSE_SPARK_MODEL=meta-models/muse-spark-open

# 2. Meta Model API for Muse Image (Visual Storytelling / Task Passport)
# MODEL_API_KEY or META_LLAMA_API_KEY can be used
MODEL_API_KEY=
META_LLAMA_API_KEY=
META_IMAGE_BASE_URL=https://api.meta.ai/v1
MUSE_IMAGE_MODEL=muse-image-1.0

# 3. Visual Storytelling Options
SAHAAY_ENABLE_VISUAL_STORYTELLING=true
SAHAAY_VISUAL_STORYTELLING_BUDGET=10

