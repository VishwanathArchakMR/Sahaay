      "driver_provenance": "test_fixture",
      "oracle": {
        "expected_status": "COMPLETED",
        "required_facts": {
          "topic": "Project Sahaay Quarterly Report",
          "document_id": "DOC-SAHAAY-2026-Q3"
        },
        "required_citations": ["data/fixtures/project_report.txt"],
        "disallow_unsupported_facts": true
      }
    },
